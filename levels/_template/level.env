# Level manifest. Copy this folder to levels/<category>-<nn>-<slug>/ and edit.
# Shell-sourced by ../../ctf.sh, so keep it `KEY=value` with no spaces around `=`.

# Stable id, also the folder name. e.g. attack-02, defense-01.
LEVEL_ID=category-00

# One-line human title.
LEVEL_TITLE="Short description of the objective"

# attack | defense
LEVEL_CATEGORY=attack

# Ordering within the game (integer).
LEVEL_NUMBER=0

# Points awarded on solve.
LEVEL_POINTS=100

# Which docker-compose service holds the secret for this level
# (vulnerable | patched | webapp). Informational.
LEVEL_TARGET=vulnerable

# Name of the variable in shared/secrets.env that holds THIS level's real flag.
# ctf.sh reads it to grade submissions, so the real flag never lives in git.
LEVEL_FLAG_VAR=LAB_FLAG_L0

# ready | planned  — planned levels show in the map but can't be submitted yet.
LEVEL_STATUS=planned
