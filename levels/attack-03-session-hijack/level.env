# Level manifest — shell-sourced by ../../ctf.sh. No spaces around `=`.
LEVEL_ID=attack-03
LEVEL_TITLE="Hijack a live session token from the heap"
LEVEL_CATEGORY=attack
LEVEL_NUMBER=3
LEVEL_POINTS=300
LEVEL_TARGET=vulnerable

# The vulnerable server keeps a victim's live session id (LAB_TOKEN) resident in
# its heap. The portal pre-seeds that session holding the level-3 flag. The
# player leaks the token and replays it to the dashboard — no login. The real
# flag lives in the gitignored shared/secrets.env as LAB_FLAG_L3; ctf.sh grades
# against it.
LEVEL_FLAG_VAR=LAB_FLAG_L3

LEVEL_STATUS=ready
