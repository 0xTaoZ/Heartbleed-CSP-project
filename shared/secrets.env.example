# Example secrets for the lab (FAKE values, memory only).
# Copy to shared/secrets.env and change the values, or make random ones
# (see docs/how-to-run.md). The real secrets.env is git-ignored.
LAB_USER=admin
LAB_PASS=S3cr3t-change-me
# LAB_TOKEN doubles as level 3's objective: it is the session id of a victim who
# is already signed in to the portal. The vulnerable server keeps it resident in
# heap memory, so a Heartbleed over-read leaks a live session the player can
# replay — no password, no login form. Use a realistic 32-hex-char token.
LAB_TOKEN=0123456789abcdef0123456789abcdef

# Per-level flags. Each level's level.env names the variable that holds its flag
# (LEVEL_FLAG_VAR), and ctf.sh grades submissions against the value here.
# LAB_FLAG is level 1's flag: the portal reveals it after a successful login.
LAB_FLAG=CTF_FLAG{replace-with-random}
# LAB_FLAG_L2 is level 2's flag: the vulnerable server encrypts it to its own
# public key at boot; the player decrypts it with the leaked private key.
LAB_FLAG_L2=CTF_FLAG{private-key-replace-me}
# LAB_FLAG_L3 is level 3's flag: the portal pre-seeds a victim session (keyed by
# LAB_TOKEN) holding this flag. The player leaks LAB_TOKEN and replays it to the
# dashboard to read the flag as the victim, without ever logging in.
LAB_FLAG_L3=CTF_FLAG{session-replace-me}
