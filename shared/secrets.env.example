# Example secrets for the lab (FAKE values, memory only).
# 实验用的示例秘密(假值,只在内存里)。
# Copy to shared/secrets.env and change the values, or make random ones
# (see docs/how-to-run.md). The real secrets.env is git-ignored.
# 复制成 shared/secrets.env 再改,或生成随机值(见 docs/how-to-run.md)。真正的 secrets.env 不进 git。
LAB_USER=admin
LAB_PASS=S3cr3t-change-me
LAB_TOKEN=0123456789abcdef0123456789abcdef
LAB_FLAG=CTF_FLAG{replace-with-random}
